# ═══════════════════════════════════════════════════════════════
# 방법 1 · 공개 시트 (권장 — 서비스 계정 키 생성 차단 학교)
# ═══════════════════════════════════════════════════════════════
# 시트: 공유 → "링크가 있는 모든 사용자" → 뷰어
GOOGLE_SHEET_ACCESS=public
GOOGLE_SHEET_ID=1SZ8fbEprPXvesQrob00lZanLyFny1E-9KOnyLWdJBok
GOOGLE_SHEET_NAME=시트1

# ═══════════════════════════════════════════════════════════════
# 방법 2 · OAuth 2.0 (서비스 계정 키 대신)
# ═══════════════════════════════════════════════════════════════
# 1) Google Cloud → 사용자 인증 정보 → OAuth 클라이언트 ID (웹 또는 데스크톱)
# 2) JSON 다운로드 → secrets/google-oauth-client.json
# 3) npm run setup:oauth → GOOGLE_REFRESH_TOKEN 발급
# GOOGLE_OAUTH_CLIENT_JSON=./secrets/google-oauth-client.json
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_SHEET_ID=1SZ8fbEprPXvesQrob00lZanLyFny1E-9KOnyLWdJBok

# ═══════════════════════════════════════════════════════════════
# 방법 3 · 서비스 계정 키 (조직 정책 iam.disableServiceAccountKeyCreation 미적용 시)
# ═══════════════════════════════════════════════════════════════
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json
# GOOGLE_SHEET_ID=1SZ8fbEprPXvesQrob00lZanLyFny1E-9KOnyLWdJBok
